{
  "name": "@meta-crm/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run src/app.spec.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@casl/ability": "6.8.1",
    "@hono/node-server": "^2.1.1",
    "@meta-crm/permissions": "workspace:*",
    "@meta-crm/types": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "6.0.0",
    "bullmq": "5.76.10",
    "dayjs": "1.11.20",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.8",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "1.13.2",
    "neverthrow": "8.2.0",
    "pg": "^8.21.0",
    "socket.io": "4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@meta-crm/config-eslint": "workspace:*",
    "@meta-crm/config-ts": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.15.33",
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "25.8.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "4.1.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.22.1",
    "typescript": "5.8.3",
    "vitest": "4.1.6"
  }
}
